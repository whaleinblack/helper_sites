# Public browser key. Restrict it by production domain, API, and quota.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only runtime secret. Enable OpenWeather One Call 4.0 for this key.
OPENWEATHER_API_KEY=

# Server-only / development research keys. They are not used by the browser bundle.
EKISPERT_API_KEY=
OPENROUTESERVICE_API_KEY=
