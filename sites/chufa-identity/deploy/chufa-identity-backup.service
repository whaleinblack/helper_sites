[Unit]
Description=Back up unified account authority
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /srv/chufa-identity/current/deploy/backup.py
ProtectSystem=strict
ReadWritePaths=/srv/chufa-identity/backups /srv/chufa-identity/shared
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
